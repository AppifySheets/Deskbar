# Store packaging helpers: turn the checked-in manifest template into the manifest for one
# version, check the package identity against the Store's values, list the image set, find
# the Windows SDK tools, and pack a staged folder into an .msix.
#
# Why a hand-written manifest and the SDK tools rather than a packaging project: every step
# is a readable file in scripts/, runnable locally and in CI, and nothing is generated by an
# IDE nobody opens. See "Package shape and how it is built" in
# docs/superpowers/specs/2026-10-24-deskbar-store-packaging-design.md.
#
# Why a module next to a thin driver (pack-store.ps1), as with ReleaseSigning.psm1: the pure
# parts (the version token, the identity check, the image list) are what Pester can test
# without publishing the app, and the tool-locating and packing parts are reusable by CI.

Set-StrictMode -Version Latest

# The Store's identity for Deskbar, verbatim from Partner Center. The Store refuses an upload
# whose Name or Publisher differ by a single character, so the pack script checks them before
# MakeAppx runs rather than learning it from a rejected submission.
$script:StoreName = 'Petre.Deskbar'
$script:StorePublisher = 'CN=804EE50D-C32E-4285-AAF6-E1C851F9FCEF'
$script:StorePublisherDisplayName = 'AppifySheets'

# The token in AppxManifest.xml that stands for the package version.
$script:VersionToken = '__VERSION__'

function Get-StoreManifest {
    <#
    .SYNOPSIS
        Returns the manifest template's text with the version token replaced by <Version>.0.
    .DESCRIPTION
        The Store requires a four-part package version whose last part is 0, and the repo's
        VersionPrefix has three parts, so the fourth is always added here and never passed in.
        Throws when the version is not three numeric parts, or when the template carries no
        token (a template that lost it would otherwise pack with whatever version it had).
    #>
    [CmdletBinding()]
    [OutputType([string])]
    param(
        [Parameter(Mandatory)] [string] $TemplatePath,
        [Parameter(Mandatory)] [string] $Version
    )

    if ($Version -notmatch '^\d+\.\d+\.\d+$') {
        throw "Version '$Version' is not a three-part version like 2.1.43; the package adds the fourth part (.0) itself."
    }

    $text = [System.IO.File]::ReadAllText((Resolve-Path -LiteralPath $TemplatePath).ProviderPath)
    if (-not $text.Contains($script:VersionToken)) {
        throw "The manifest template $TemplatePath has no $($script:VersionToken) token to replace."
    }

    $text.Replace($script:VersionToken, "$Version.0")
}

function Test-StoreIdentity {
    <#
    .SYNOPSIS
        Throws unless the manifest's Identity Name and Publisher and its PublisherDisplayName
        are exactly the Store's values.
    .DESCRIPTION
        Reads the XML rather than matching text, so attribute order and whitespace do not
        matter. Returns nothing on success; the driver only needs it not to throw.
    #>
    [CmdletBinding()]
    param([Parameter(Mandatory)] [string] $ManifestText)

    [xml]$manifest = $ManifestText
    # The manifest's elements live in the foundation namespace, so local-name() avoids
    # carrying a namespace manager for three reads.
    $identity = $manifest.SelectSingleNode("/*[local-name()='Package']/*[local-name()='Identity']")
    $displayName = $manifest.SelectSingleNode("/*[local-name()='Package']/*[local-name()='Properties']/*[local-name()='PublisherDisplayName']")
    if ($null -eq $identity) { throw 'The manifest has no Package/Identity element.' }

    $checks = @(
        @{ Field = 'Name'; Actual = $identity.GetAttribute('Name'); Expected = $script:StoreName },
        @{ Field = 'Publisher'; Actual = $identity.GetAttribute('Publisher'); Expected = $script:StorePublisher },
        @{ Field = 'PublisherDisplayName'; Actual = $(if ($displayName) { $displayName.InnerText } else { '' }); Expected = $script:StorePublisherDisplayName }
    )
    # -cne: the Store compares these exactly, case included.
    $wrong = @($checks | Where-Object { $_.Actual -cne $_.Expected })
    if ($wrong.Count -gt 0) {
        $details = ($wrong | ForEach-Object { "$($_.Field) is '$($_.Actual)', expected '$($_.Expected)'" }) -join '; '
        throw "The manifest's identity does not match the Store's: $details."
    }
}

function Get-RequiredImages {
    <#
    .SYNOPSIS
        The file names under Package\Images that the manifest and the resource index expect.
    .DESCRIPTION
        The set the spec names ("Images and the resource index"). Under the package the shell
        draws the taskbar, Alt+Tab and Start icons from these, not from deskbar.ico, and with
        only one plain Square44x44Logo they come out plated on a coloured tile. So: the plated
        Square44x44Logo at five scales; target sizes 16, 24, 32, 48 and 256, each plain,
        altform-unplated (taskbar, Alt+Tab) and altform-lightunplated (the same, light theme);
        and Square150x150Logo, StoreLogo and Wide310x150Logo at scale 100 and 200.
        scripts/make-store-images.ps1 generates exactly this list.
    #>
    [CmdletBinding()]
    [OutputType([string[]])]
    param()

    $plated = @(100, 125, 150, 200, 400) | ForEach-Object { "Square44x44Logo.scale-$_.png" }
    $targetSizes = @(16, 24, 32, 48, 256) | ForEach-Object {
        "Square44x44Logo.targetsize-$_.png"
        "Square44x44Logo.targetsize-${_}_altform-unplated.png"
        "Square44x44Logo.targetsize-${_}_altform-lightunplated.png"
    }
    $tiles = @('Square150x150Logo', 'StoreLogo', 'Wide310x150Logo') | ForEach-Object {
        $name = $_
        @(100, 200) | ForEach-Object { "$name.scale-$_.png" }
    }

    [string[]]($plated + $targetSizes + $tiles)
}

function Find-SdkTool {
    <#
    .SYNOPSIS
        The newest Windows SDK copy of a tool (MakeAppx.exe, MakePri.exe, signtool.exe).
    .DESCRIPTION
        Looks under ${env:ProgramFiles(x86)}\Windows Kits\10\bin\<version>\x64 and takes the
        highest version that has the tool, the way Find-SignTool in ReleaseSigning.psm1 finds
        signtool. Folders under bin that are not versions (arm64, x64, x86) sort last. Throws
        when no SDK version carries the tool.
    #>
    [CmdletBinding()]
    [OutputType([string])]
    param([Parameter(Mandatory)] [string] $Name)

    $kitsBin = Join-Path ${env:ProgramFiles(x86)} 'Windows Kits\10\bin'
    $newest = Get-ChildItem -Path (Join-Path $kitsBin "*\x64\$Name") -ErrorAction SilentlyContinue |
        Sort-Object { try { [version]$_.Directory.Parent.Name } catch { [version]'0.0' } } -Descending |
        Select-Object -First 1
    if ($newest) { return $newest.FullName }

    throw "$Name not found under $kitsBin\<version>\x64. Install the Windows SDK (App Certification Kit / packaging tools)."
}

function Invoke-SdkTool {
    # Runs an SDK tool, echoes its output, and throws with that output on a non-zero exit.
    # Under Windows PowerShell 5.1 with a Stop preference (the driver sets one) a tool's
    # stderr would turn into a NativeCommandError before the exit code could be read, so
    # Continue is scoped to this function and the exit code decides.
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)] [string] $Path,
        [Parameter(Mandatory)] [string[]] $Arguments
    )

    $ErrorActionPreference = 'Continue'
    $output = & $Path @Arguments 2>&1 | Out-String
    # MakePri writes UTF-16 when its output is redirected, which PowerShell decodes as one byte
    # per character, so every other character is a NUL ("S u c c e s s"). Its text is ASCII, so
    # dropping the NULs restores it; the other tools write no NULs and are unaffected.
    $output = $output.Replace([string][char]0, '')
    # Echo what the tool said, minus MakeAppx's one line per packed file (several hundred for a
    # self-contained publish) and blank lines; the full text still goes into the error below.
    # -InformationAction Continue: a module function does not see the calling script's
    # $InformationPreference, and the tool's own report is the evidence that it ran clean.
    $summary = ($output -split "`r?`n" | Where-Object { $_.Trim() -and $_ -notmatch '^Processing ".*" as a payload file\.' }) -join [Environment]::NewLine
    Write-Information -MessageData $summary -InformationAction Continue
    if ($LASTEXITCODE -ne 0) {
        throw "$(Split-Path -Leaf $Path) failed with exit code ${LASTEXITCODE}: $output"
    }
}

function Invoke-StorePack {
    <#
    .SYNOPSIS
        Stages a published app with the manifest and images, indexes the images and packs an .msix.
    .DESCRIPTION
        StageDir is emptied and rebuilt: the published files at its root (Deskbar.exe and
        deskbar-cli.exe side by side, as the manifest's Executable attributes expect), the
        manifest text as AppxManifest.xml, the images under Images\, and resources.pri from
        MakePri. Then MakeAppx packs the folder into Output, overwriting it. The package is
        unsigned; the Store signs what it receives.
    .PARAMETER ManifestText
        The manifest with its version already filled in (Get-StoreManifest).
    #>
    [CmdletBinding()]
    param(
        [Parameter(Mandatory)] [string] $PublishDir,
        [Parameter(Mandatory)] [string] $StageDir,
        [Parameter(Mandatory)] [string] $ManifestText,
        [Parameter(Mandatory)] [string] $ImagesDir,
        [Parameter(Mandatory)] [string] $Output
    )

    # Every image the manifest and the index expect must be there, or the shell falls back
    # to a plated or blank icon with no error anywhere. Fail here instead.
    $missing = @(Get-RequiredImages | Where-Object { -not (Test-Path -LiteralPath (Join-Path $ImagesDir $_) -PathType Leaf) })
    if ($missing.Count -gt 0) { throw "Missing images in ${ImagesDir}: $($missing -join ', ')" }

    # A fresh stage each time, so a file dropped from the publish does not linger in the package.
    if (Test-Path -LiteralPath $StageDir) { Remove-Item -LiteralPath $StageDir -Recurse -Force }
    New-Item -ItemType Directory -Path $StageDir | Out-Null

    Copy-Item -Path (Join-Path $PublishDir '*') -Destination $StageDir -Recurse -Force
    $stageImages = Join-Path $StageDir 'Images'
    New-Item -ItemType Directory -Path $stageImages -Force | Out-Null
    Get-RequiredImages | ForEach-Object { Copy-Item -LiteralPath (Join-Path $ImagesDir $_) -Destination $stageImages }

    # UTF-8 without a BOM: MakeAppx reads either, but this keeps the staged file byte-identical
    # to what a text editor would save from the template.
    $manifestPath = Join-Path $StageDir 'AppxManifest.xml'
    [System.IO.File]::WriteAllText($manifestPath, $ManifestText, (New-Object System.Text.UTF8Encoding $false))

    # The resource index. Qualified names (Square44x44Logo.targetsize-16_altform-unplated.png)
    # resolve only through resources.pri; without it the shell sees just the unqualified names
    # the manifest uses, which do not exist as files.
    #
    # MakePri names resources relative to where indexing starts, so it has to start at the
    # folder above Images\ for the names to come out as Files/Images/..., matching the
    # manifest. Starting at the stage would also index every published DLL, so it indexes a
    # scratch root holding only a copy of Images\ (priconfig.xml says more). /mn gives MakePri
    # the package name from the staged manifest.
    $priConfig = Join-Path (Split-Path -Parent $ImagesDir) 'priconfig.xml'
    $priRoot = Join-Path ([System.IO.Path]::GetTempPath()) "store-pri-$([guid]::NewGuid().ToString('N'))"
    try {
        Copy-Item -LiteralPath $stageImages -Destination (Join-Path $priRoot 'Images') -Recurse
        $makePri = Find-SdkTool -Name 'MakePri.exe'
        Invoke-SdkTool -Path $makePri -Arguments @(
            'new', '/pr', $priRoot, '/cf', $priConfig, '/mn', $manifestPath,
            '/of', (Join-Path $StageDir 'resources.pri'), '/o')
    }
    finally {
        Remove-Item -LiteralPath $priRoot -Recurse -Force -ErrorAction SilentlyContinue
    }

    # The package itself. /o overwrites an existing output file without asking.
    $outputDir = Split-Path -Parent $Output
    if ($outputDir -and -not (Test-Path -LiteralPath $outputDir)) { New-Item -ItemType Directory -Path $outputDir | Out-Null }
    $makeAppx = Find-SdkTool -Name 'MakeAppx.exe'
    Invoke-SdkTool -Path $makeAppx -Arguments @('pack', '/d', $StageDir, '/p', $Output, '/o')
}

function Invoke-StoreTestSign {
    <#
    .SYNOPSIS
        Signs a package with a self-signed certificate whose subject is the Store publisher, for
        sideloading on this machine only. Returns the certificate used.
    .DESCRIPTION
        Windows installs a package only when its signer's subject equals the manifest's
        Publisher, so the test certificate's subject is exactly the Store's publisher string.
        Reuses the newest unexpired one in Cert:\CurrentUser\My with a private key, or creates
        one there (code signing EKU, end entity, as Microsoft's MSIX test-signing steps do).
        It never touches any other store: trusting it for installation needs the certificate
        in Cert:\LocalMachine\TrustedPeople, which needs elevation, and that stays a step the
        person takes on purpose. The Store does not use this signature; it re-signs what it
        receives.
    #>
    [CmdletBinding()]
    [OutputType([System.Security.Cryptography.X509Certificates.X509Certificate2])]
    param([Parameter(Mandatory)] [string] $Path)

    $codeSigningOid = '1.3.6.1.5.5.7.3.3'
    $certificate = Get-ChildItem -Path Cert:\CurrentUser\My |
        Where-Object {
            $_.Subject -eq $script:StorePublisher -and $_.HasPrivateKey -and $_.NotAfter -gt (Get-Date) -and
            @($_.EnhancedKeyUsageList | Where-Object { $_.ObjectId -eq $codeSigningOid }).Count -gt 0
        } |
        Sort-Object NotAfter -Descending |
        Select-Object -First 1

    if ($null -eq $certificate) {
        # 2.5.29.37 is the extended key usage (code signing); 2.5.29.19 with no text is basic
        # constraints for an end entity, so the certificate cannot act as a CA.
        $certificate = New-SelfSignedCertificate -Type Custom -Subject $script:StorePublisher `
            -KeyUsage DigitalSignature -FriendlyName 'Deskbar Store package test signing' `
            -CertStoreLocation Cert:\CurrentUser\My `
            -TextExtension @("2.5.29.37={text}$codeSigningOid", '2.5.29.19={text}')
        Write-Information "Created test certificate $($certificate.Thumbprint) in Cert:\CurrentUser\My" -InformationAction Continue
    }
    else {
        Write-Information "Reusing test certificate $($certificate.Thumbprint) from Cert:\CurrentUser\My" -InformationAction Continue
    }

    # No timestamp: a sideloading test package does not need to outlive its certificate.
    $signtool = Find-SdkTool -Name 'signtool.exe'
    Invoke-SdkTool -Path $signtool -Arguments @('sign', '/fd', 'SHA256', '/sha1', $certificate.Thumbprint, '/s', 'My', $Path)
    $certificate
}

Export-ModuleMember -Function Get-StoreManifest, Test-StoreIdentity, Get-RequiredImages, Find-SdkTool, Invoke-StorePack, Invoke-StoreTestSign
