<Project Sdk="Microsoft.NET.Sdk">

  <!-- Throwaway probes for quick find (docs/superpowers/plans/2026-11-04-quick-find.md, Task 0).
       A console project rather than dotnet-script files: UI Automation lives in WindowsDesktop
       assemblies that dotnet script cannot load. Not part of Deskbar.sln. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

</Project>
