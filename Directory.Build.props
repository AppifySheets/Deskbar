<Project>
  <!-- Shared compiler settings for every project in the solution. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Version and product identity, shared by every project so the exe, its file
       properties and any future NuGet package can never disagree.

       The version is NOT written here. Nerdbank.GitVersioning computes it from version.json
       (the major.minor line) and the git height (commits since version.json last changed), so
       every commit has one fixed version and a pull request never edits a version file. A minor
       bump is a pull request that edits version.json. It needs the full git history: a shallow
       clone fails the build, and a source zip without .git builds as x.y.0.

       What the package sets, and what Windows and .NET read:
         Version                - the semantic version, 2.4.7 (a non-main build: 2.4.7-g<hash>)
         AssemblyVersion        - what assembly binding uses; kept at the major version with zeros
                                  (2.0.0.0 for 2.x, version.json: assemblyVersion precision major)
                                  so servicing releases never break a reference
         FileVersion            - what Explorer's Details tab shows. Its 4th part is a number the
                                  tool derives from the commit id: not zero and not increasing.
                                  Accepted on purpose; the Store package has its own x.y.z.0.
         InformationalVersion   - 2.4.7+<commit hash>; what the app reads as its own version -->
  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.10.94" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <Product>Deskbar</Product>
    <Company>AppifySheets</Company>
    <Authors>Petre Chitashvili</Authors>
    <Copyright>Copyright © AppifySheets 2026</Copyright>
    <Description>The taskbar for your virtual desktops: name them, see every window on one bar.</Description>
    <RepositoryUrl>https://github.com/AppifySheets/Deskbar</RepositoryUrl>
  </PropertyGroup>
</Project>
