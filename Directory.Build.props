<Project>
  <!-- Shared compiler settings for every project in the solution. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Version and product identity, shared by every project so the exe, its file
       properties and any future NuGet package can never disagree.

       The version is NOT written here. Nerdbank.GitVersioning computes it from version.json. In
       the repository that file names only major.minor, so a build on a developer's machine is
       major.minor.<git height> (commits since version.json last changed), and a pull request
       never edits a version file. A RELEASE is numbered one above the previous release instead:
       the release workflow writes that number into its own checkout's version.json as a
       three-part version, and Nerdbank uses it as it stands (scripts/ReleaseVersion.psm1). So a
       local build's patch is usually higher than the latest release's and says nothing about
       it. A minor bump is a pull request that edits version.json. It needs the full git
       history: a shallow clone fails the build, and a source zip without .git builds as x.y.0.

       What the package sets, and what Windows and .NET read:
         Version                - the semantic version, 2.4.7 (a non-main build: 2.4.7-g<hash>)
         AssemblyVersion        - what assembly binding uses; kept at the major version with zeros
                                  (2.0.0.0 for 2.x, version.json: assemblyVersion precision major)
                                  so servicing releases never break a reference
         FileVersion            - what Explorer's Details tab shows. In a release it is x.y.z.0
                                  (Nerdbank puts the height in the 4th part when version.json
                                  names a patch, and the height of that uncommitted edit is 0).
                                  In a local build the 4th part is a number the tool derives from
                                  the commit id: not zero and not increasing. Accepted on purpose.
         InformationalVersion   - 2.4.7+<commit hash>; what the app reads as its own version -->
  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.10.94" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <Product>Deskbar</Product>
    <Company>AppifySheets</Company>
    <Authors>Petre Chitashvili</Authors>
    <Copyright>Copyright © AppifySheets 2026</Copyright>
    <Description>The taskbar for your virtual desktops: name them, see every window on one bar.</Description>
    <RepositoryUrl>https://github.com/AppifySheets/Deskbar</RepositoryUrl>
  </PropertyGroup>
</Project>
