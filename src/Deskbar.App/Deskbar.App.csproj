<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Deskbar.Core\Deskbar.Core.csproj" />
    <ProjectReference Include="..\Deskbar.Windows\Deskbar.Windows.csproj" />
  </ItemGroup>

  <!-- The bar's press-routing helpers are internal rather than private so they can be tested
       directly. That was bought with a real crash: pressing the info line's text handed
       StartedOnIcon a Run, VisualTreeHelper.GetParent THREW on it (a Run is a ContentElement,
       not a Visual) and the unhandled exception took the process down. Reproducing it through
       the routed event proved impossible, because a tunnelling event raised on a ContentElement
       does not route to the window at all, so the rule is pinned where it actually lives. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Deskbar.Windows.Tests" />
  </ItemGroup>

  <!-- Finding 7 (reviewer, promoted Minor): System.Drawing.Common removed — the
       WindowsDesktop/UseWPF framework already provides System.Drawing.Common on Windows,
       so the explicit PackageReference only produced an NU1510 "unnecessary reference"
       warning. Verified SystemIcons.Application (App.xaml.cs) still resolves without it. -->
  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- ApplicationIcon stamps the icon into the exe itself (Explorer, taskbar, alt-tab,
         the Programs list). The Resource entry is what lets the RUNNING app load the same
         file for its tray icon and window icons via a pack:// URI, so there is exactly one
         source of truth for the app's identity. Generated as a 9-resolution ico
         (16..256) so Windows never has to rescale, which is what makes small sizes look
         crisp rather than smudged. -->
    <Resource Include="Assets\deskbar.ico" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The product is Deskbar, so the exe and the entry assembly are Deskbar, not the project's own
         name (Deskbar.App), which is why this file does not match the output. The pack:// URIs and
         StartupRegistration.IsTheApp both key on this name, so it stays Deskbar. -->
    <AssemblyName>Deskbar</AssemblyName>
    <ApplicationIcon>Assets\deskbar.ico</ApplicationIcon>
    <!-- Declares Per-Monitor V2 DPI awareness; app.manifest says why a docked bar needs it. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Must match Deskbar.Windows' TFM exactly (net10.0-windows alone is a different,
         incompatible target from the project-reference resolver's point of view). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

</Project>
