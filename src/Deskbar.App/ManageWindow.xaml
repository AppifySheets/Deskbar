<!-- Icon uses an ABSOLUTE pack URI naming the assembly, not the short "/Assets/..." form:
     the short form resolves against Application.ResourceAssembly, which a WPF exe's generated
     Main sets but a test host does not, so it made this window unconstructable under test
     with "Cannot locate resource". Same form in PromptDialog and App.AppIcon. -->
<Window x:Class="Deskbar.App.ManageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Deskbar.App"
        Title="Deskbar: Manage" Width="720" Height="480"
        Icon="pack://application:,,,/Deskbar;component/Assets/deskbar.ico">
    <DockPanel>
        <TextBlock x:Name="CompatBanner" DockPanel.Dock="Top" Background="#FFF4CE" Padding="8"
                   Text="⚠ Virtual desktops are unavailable on this Windows build. Workspaces are listed but windows will not be moved."
                   Visibility="Collapsed"/>
        <!-- Nothing sits between the tabs and the window's edge. Every setting used to be stacked here, below the tabs,
             where it took the room of whichever tab was open: by the eighth box the Settings tab had about 110 DIP left
             for its sliders, and the longest label ran off the window's edge. They are all on the Settings tab now,
             in sections, and the tab scrolls. A new setting goes into one of its sections, never back here. -->
        <TabControl>
            <!-- FIRST, so Manage opens on it. EVERY SETTING, in three sections: Deskbar on this PC, the bar, and the windows on the desktop. #151 started
                 the tab with the bar's sliders (Petre: "make things configurable, like dimming opacity, timeout, etc."); the
                 boxes that used to sit below the tabs joined them later, so the tab is the one place a setting lives.
                 Sliders rather than number boxes, and that is not a style choice: every slider value is something you LOOK
                 at rather than a number you know, so the control has to show you the answer while you choose it. Boxes and
                 sliders apply to the live bar as they change, which is why nothing here has a Save button; only the tile
                 gap and the shortcuts (on their own tab) have Apply, so a half-typed number is never stored.
                 A setting earns its place when a need actually shows up; a wall of options nobody asked for is its own bug.
                 There is deliberately no "Show floating bar" box. Petre: "show floating bar doesn't make sense anymore,
                 it's crucial for the app's design." The bar is the only surface that shows windows and jumps to them, so
                 hiding it would be like switching off the taskbar, and it would hide the only way back to your windows. -->
            <TabItem Header="Settings">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Boxes and sliders apply at once. There is nothing to save and nothing to restart."/>
                    <!-- The reset button and the version share the row that never scrolls. -->
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <!-- #82: the running version, small and out of the way. Dim, because it answers a question asked
                             rarely ("what am I running"), and it is not a control. -->
                        <TextBlock x:Name="AppVersion" DockPanel.Dock="Right" Opacity="0.55" VerticalAlignment="Center"/>
                        <!-- The only way back from a slider once moved, which is why it is not optional: without it the
                             tab is a one-way door. It clears the stored values rather than writing the defaults as
                             numbers, so a default changed in a later build still reaches anyone who pressed this. It
                             resets the bar's look (sliders and the bottom strip) and nothing else, and its label says so. -->
                        <Button x:Name="ResetAppearanceButton" Content="Reset the bar's look to defaults" Padding="12,2"
                                HorizontalAlignment="Left" Click="OnResetAppearance"/>
                    </DockPanel>
                    <!-- Scrolls, because the tab outgrew the window. Petre: "settings page can't be scrolled and it
                         doesn't fit on a page in smaller res screens". Only the controls scroll: the line above and the
                         reset button below stay put, so the way back is always in view. -->
                    <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,8,0">
                        <!-- SECTION 1: DESKBAR ON THIS PC. First, because "Start Deskbar with Windows" is the box the
                             README's first steps send a new user to, and it should not need scrolling to find. -->
                        <TextBlock Text="Deskbar on this PC" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <!-- The box drives StartupSwitch: the Run value in the direct build, the package's startup task in
                             the Store copy (docs/superpowers/specs/2026-10-24-deskbar-store-packaging-design.md). The note
                             under it says why the box is greyed out (the startup task was turned off in Settings or by
                             policy), that the state could not be read, or, in the direct build, that the Store copy is
                             installed too. Collapsed whenever there is nothing to say; the code behind sets both. -->
                        <CheckBox x:Name="StartWithWindows" Content="Start Deskbar with Windows"
                                  Checked="OnStartupToggled" Unchecked="OnStartupToggled"/>
                        <TextBlock x:Name="StartupNote" TextWrapping="Wrap" Margin="20,2,0,0" Opacity="0.75" Visibility="Collapsed"/>
                        <!-- #71. The opt-out for the app's only phone-home behaviour. The wording says what actually
                             happens: it checks and tells you, and that is all. The Store copy rewords it from code. -->
                        <CheckBox x:Name="CheckForUpdates" Margin="0,6,0,0"
                                  Content="Check GitHub for new versions (tells you; never installs anything)"
                                  Checked="OnCheckForUpdatesToggled" Unchecked="OnCheckForUpdatesToggled"/>
                        <!-- The Claude Code skill (AppState.ClaudeSkill, ClaudeSkill.cs). Petre: "add a skill for claude per
                             user". On by default, and it only ever writes when Claude Code's own folder exists. What it
                             writes is under the box rather than in its label, which ran off the window's edge. -->
                        <CheckBox x:Name="ClaudeSkill" Margin="0,6,0,0" Content="Teach Claude Code about Deskbar"
                                  Checked="OnClaudeSkillToggled" Unchecked="OnClaudeSkillToggled"/>
                        <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Opacity="0.75"
                                   Text="Writes a skill to ~/.claude/skills/deskbar and two hooks to ~/.claude/settings.json, so Claude Code sessions open windows in their own workspace and make it blink when they need you."/>
                        <!-- Claude Code sessions in the task list (AppState.ClaudeTasks; design
                             docs/superpowers/specs/2026-11-22-tasks-board-design.md, "Who gets it"). A setting of its own,
                             on by default, indented under the box above because it writes into the same files and only
                             works with it: the code behind greys it out, unticked, while that box is unticked. -->
                        <CheckBox x:Name="ClaudeTasks" Margin="20,6,0,0" Checked="OnClaudeTasksToggled" Unchecked="OnClaudeTasksToggled">
                            <TextBlock TextWrapping="Wrap" Text="Claude Code sessions keep their tasks in the task list"/>
                        </CheckBox>
                        <TextBlock TextWrapping="Wrap" Margin="40,2,0,0" Opacity="0.75"
                                   Text="Adds three more hooks, so each session joins or starts a task, keeps its status current and asks you through it."/>
                        <!-- Resuming the sessions of open tasks (AppState.ClaudeResume, ClaudeSessions; design
                             docs/superpowers/specs/2026-11-23-tasks-open-claude-sessions-design.md, "Keeping open tasks
                             running" and "The setting"). The spec asks for a switch that turns the automatic resume off
                             without turning off the rest of the feature, so it sits under the tasks box and, like that box
                             under the teaching, is greyed and unticked while the tasks box is. The line under it is the
                             retention note the spec puts "beside the setting": an ended session can only be resumed while
                             Claude Code still keeps its transcript, and Deskbar never changes that setting itself. -->
                        <CheckBox x:Name="ClaudeResume" Margin="40,6,0,0" Checked="OnClaudeResumeToggled" Unchecked="OnClaudeResumeToggled">
                            <TextBlock TextWrapping="Wrap" Text="Resume the sessions of open tasks after a restart or a crash"/>
                        </CheckBox>
                        <TextBlock TextWrapping="Wrap" Margin="60,2,0,0" Opacity="0.75"
                                   Text="Claude Code keeps sessions for 30 days; raise cleanupPeriodDays in ~/.claude/settings.json to keep them longer"/>
                        <!-- Why Claude Code's list of sessions cannot be read (Ruling 20; ClaudeSessions.ListProblem):
                             `claude` missing from the PATH, or a read that failed or could not be parsed. Then nothing is
                             resumed or adopted, and without this line nothing in Deskbar would say so. Hidden while the
                             list reads, and cleared by the next good read. -->
                        <TextBlock x:Name="ClaudeListProblem" TextWrapping="Wrap" Margin="60,4,0,0" Foreground="#C42B1C"
                                   Visibility="Collapsed"/>

                        <!-- SECTION 2: THE BAR. -->
                        <TextBlock Text="The bar" FontSize="15" FontWeight="SemiBold" Margin="0,20,0,6"/>
                        <!-- Docking the bar as an app bar (AppState.DockBar). Off by default; Petre: "make this a config
                             setting and disable by default". -->
                        <CheckBox x:Name="DockBar" Checked="OnDockBarToggled" Unchecked="OnDockBarToggled">
                            <TextBlock TextWrapping="Wrap" Text="Dock the bar to the edge of its screen, like the taskbar, so windows keep clear of it"/>
                        </CheckBox>
                        <!-- The see-through band behind the bar's workspace rows (AppState.SeeThrough,
                             FloatingBar.Surface.cs). Petre: "make grain a default feature, configurable in settings",
                             then the see-through band took the grain's place ("let's take that instead, 85%"). On by
                             default. -->
                        <CheckBox x:Name="SeeThrough" Margin="0,6,0,0" Checked="OnSeeThroughToggled" Unchecked="OnSeeThroughToggled">
                            <TextBlock TextWrapping="Wrap" Text="Let the desktop show faintly through the bar behind workspaces you have not used lately"/>
                        </CheckBox>
                        <!-- The previous workspace's item (AppState.PreviousWorkspaceItemChoice, FloatingBar.JumpsFor). Until
                             the box is ticked or unticked by hand it follows the desk (WorkspaceJumps.BackItemWanted): ticked
                             while the window list is on the screen strips and the taskbar auto-hides. The note says so,
                             because a box that changes by itself when the taskbar setting changes needs explaining. -->
                        <CheckBox x:Name="PreviousWorkspaceItem" Margin="0,6,0,0"
                                  Content="Show the previous workspace on the strips and the taskbar"
                                  Checked="OnPreviousWorkspaceItemToggled" Unchecked="OnPreviousWorkspaceItemToggled"/>
                        <TextBlock TextWrapping="Wrap" Margin="20,2,0,16" Opacity="0.75"
                                   Text="Until you tick or untick it, it is on while the window list is on the screens and Windows' taskbar auto-hides."/>

                        <!-- What the bar's bottom strip shows (AppState.HiddenStripItems, StripItem). Petre: "i
                             don't want wifi there", "and i don't think i want notifications either", "make it a
                             setting, what to show". One box per item, built in code from StripItem so a new item
                             cannot be forgotten here. -->
                        <TextBlock Text="Bottom strip" FontWeight="Bold"/>
                        <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,6"
                                   Text="What the strip at the bottom of the bar shows. Untick what you do not use, and the rest close up. When the strip is still too narrow, the clock's date goes first and then the clock, so the language switcher always keeps its place."/>
                        <WrapPanel x:Name="StripItemsPanel" Orientation="Horizontal" Margin="0,0,0,16"/>

                        <TextBlock Text="Dimming" FontWeight="Bold"/>
                        <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,6"
                                   Text="How faint the bar goes once the pointer is elsewhere. Fully opaque means it never dims. It never goes fully invisible: an unseeable bar still swallows the clicks aimed at whatever is behind it. A docked bar never dims, since nothing sits under it."/>
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="IdleOpacitySlider" Width="260" Minimum="0.05" Maximum="1"
                                    SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    ValueChanged="OnAppearanceChanged"/>
                            <TextBlock x:Name="IdleOpacityValue" Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="70"/>
                        </StackPanel>

                        <TextBlock Text="Before it starts dimming" FontWeight="Bold" Margin="0,16,0,0"/>
                        <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,6"
                                   Text="The bar holds full strength for this long after the pointer leaves, because the moment just after you stop pointing at it is when you are still reading it. Zero starts the fade immediately."/>
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="FadeGraceSlider" Width="260" Minimum="0" Maximum="120"
                                    SmallChange="1" LargeChange="5" TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="OnAppearanceChanged"/>
                            <TextBlock x:Name="FadeGraceValue" Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="70"/>
                        </StackPanel>

                        <TextBlock Text="How long the dimming takes" FontWeight="Bold" Margin="0,16,0,0"/>
                        <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,6"
                                   Text="Slow enough that the change is never what catches your eye. Brightening stays instant either way: reaching for the bar should feel like it was already there."/>
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="FadeDurationSlider" Width="260" Minimum="0.1" Maximum="20"
                                    SmallChange="0.1" LargeChange="1" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                    ValueChanged="OnAppearanceChanged"/>
                            <TextBlock x:Name="FadeDurationValue" Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="70"/>
                        </StackPanel>

                        <TextBlock Text="Hover card delay" FontWeight="Bold" Margin="0,16,0,0"/>
                        <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,6"
                                   Text="How long the pointer has to rest on an icon before its preview appears. The card carries a picture of the window, so it is asked for rather than triggered by a pointer passing through on its way somewhere else."/>
                        <!-- The checkbox is how "inherit" is expressed, and inheriting is the default
                             rather than a fallback: MouseHoverTime is what the taskbar's own thumbnails
                             wait for, so the bar behaves like the rest of the desktop until told not to. -->
                        <CheckBox x:Name="InheritHoverDwell" Margin="0,0,0,6"
                                  Checked="OnAppearanceChanged" Unchecked="OnAppearanceChanged"/>
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="HoverDwellSlider" Width="260" Minimum="0" Maximum="1500"
                                    SmallChange="50" LargeChange="100" TickFrequency="50" IsSnapToTickEnabled="True"
                                    ValueChanged="OnAppearanceChanged"/>
                            <TextBlock x:Name="HoverDwellValue" Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="70"/>
                        </StackPanel>

                        <!-- One offset for every piece of bar text, in half points (BarText). It has its own
                             handler and its own setter, so dragging it writes only this value. -->
                        <TextBlock Text="Text size" FontWeight="Bold" Margin="0,16,0,0"/>
                        <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,6"
                                   Text="Added to every piece of text on the bar, in half points, so the captions, the clock and the now-playing line all grow or shrink together. Larger text wraps workspace names sooner."/>
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="TextSizeSlider" Width="260" Minimum="-2" Maximum="8"
                                    SmallChange="0.5" LargeChange="1" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                    ValueChanged="OnTextSizeChanged"/>
                            <TextBlock x:Name="TextSizeValue" Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="70"/>
                        </StackPanel>

                        <!-- The icon size (IconScaling), in percent, with its own handler and setter like the text
                             size. Petre: "let's also make icon sizes configurable", "as a separate setting",
                             "including icons at the bottom". -->
                        <TextBlock Text="Icon size" FontWeight="Bold" Margin="0,16,0,0"/>
                        <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,6"
                                   Text="How big the bar draws its icons: the apps in the rows, the pinned apps with Start and search, and the icons in the bottom strip. Text keeps its own size. Bigger icons fit fewer to a line, so busy rows grow taller."/>
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="IconSizeSlider" Width="260" Minimum="60" Maximum="160"
                                    SmallChange="5" LargeChange="10" TickFrequency="5" IsSnapToTickEnabled="True"
                                    ValueChanged="OnIconSizeChanged"/>
                            <TextBlock x:Name="IconSizeValue" Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="70"/>
                        </StackPanel>

                        <!-- The docked bar's frost strength (FrostBlur, FloatingBar.Frost.cs), with its own handler and
                             setter like the text size. Petre, on the first frost: "it's too blurry", "make it a setting?" -->
                        <TextBlock Text="Wallpaper blur" FontWeight="Bold" Margin="0,16,0,0"/>
                        <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,6"
                                   Text="How blurred your wallpaper is behind the workspace rows, docked or floating, in screen pixels. At 0 it shows sharp under the bar's veil. Needs the see-through band above."/>
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="FrostBlurSlider" Width="260" Minimum="0" Maximum="32"
                                    SmallChange="1" LargeChange="4" TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="OnFrostBlurChanged"/>
                            <TextBlock x:Name="FrostBlurValue" Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="70"/>
                        </StackPanel>

                        <!-- The window list's floor (WindowListLines), with its own handler and setter like the
                             text size, so dragging it writes only this value. -->
                        <TextBlock Text="Window list height" FontWeight="Bold" Margin="0,16,0,0"/>
                        <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,6"
                                   Text="The fewest lines the current workspace's window list keeps, so windows can come and go without the bar changing height. With more windows than this, the list grows."/>
                        <StackPanel Orientation="Horizontal">
                            <Slider x:Name="ListLinesSlider" Width="260" Minimum="1" Maximum="12"
                                    SmallChange="1" LargeChange="1" TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="OnListLinesChanged"/>
                            <TextBlock x:Name="ListLinesValue" Margin="8,0,0,0" VerticalAlignment="Center" MinWidth="70"/>
                        </StackPanel>

                        <!-- SECTION 3: WINDOWS ON THE DESKTOP: what Deskbar does to other programs' windows. -->
                        <TextBlock Text="Windows on the desktop" FontSize="15" FontWeight="SemiBold" Margin="0,20,0,6"/>
                        <!-- The focus ring (AppState.FocusRing, FocusRings in Core, WindowRings). Petre: "can you give each
                             active window a ring, same in color as in the bar?", then "go with proposed": on by default. -->
                        <CheckBox x:Name="FocusRing" Content="Outline the window you are in with its workspace's colour"
                                  Checked="OnFocusRingToggled" Unchecked="OnFocusRingToggled"/>
                        <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Opacity="0.75"
                                   Text="The window in front on each other screen gets a dim white outline."/>
                        <!-- Windows' "Show flashing on taskbar apps", held off while Deskbar runs and put back when it stops
                             (AppState.QuietTaskbarChoice; docs/superpowers/specs/2026-11-18-taskbar-flashing-switch-design.md).
                             A flashing app holds an auto-hidden taskbar up until it is clicked, and the bar's amber dot
                             already shows the flash. Until the box is ticked or unticked by hand it follows auto-hide
                             (TaskbarFlashing.Wanted): ticked while the taskbar auto-hides, unticked while it is always shown.
                             The note under the box suggests it to someone who unticked it on an auto-hidden taskbar while
                             Windows flashes (TaskbarFlashing.Note). -->
                        <CheckBox x:Name="QuietTaskbar" Margin="0,6,0,0"
                                  Content="Stop apps flashing on Windows' taskbar while Deskbar runs"
                                  Checked="OnQuietTaskbarToggled" Unchecked="OnQuietTaskbarToggled"/>
                        <TextBlock TextWrapping="Wrap" Margin="20,2,0,0" Opacity="0.75"
                                   Text="The bar's amber dot shows them instead."/>
                        <TextBlock x:Name="QuietTaskbarNote" TextWrapping="Wrap" Margin="20,2,0,0" Opacity="0.75" Visibility="Collapsed"/>
                        <!-- Tiling (AppState.TileGap; docs/superpowers/specs/2026-11-08-tiling-design.md). There is no on/off
                             box: tiling is always available and a workspace is tiled with the tile button at the top of the
                             bar (Petre, 2026-11-19: "enable tiling in the settings and remove it as an option; it's enough to
                             have a button at the top"). Only the gap is a setting. The number is applied with its button, as
                             the shortcut boxes are, so a half-typed value is never stored. -->
                        <StackPanel x:Name="TileGapPanel" Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="Gap between tiled windows, in pixels at 100% scaling" VerticalAlignment="Center"/>
                            <TextBox x:Name="TileGapBox" Width="48" Margin="8,0,0,0"/>
                            <Button x:Name="TileGapApply" Content="Apply" Margin="8,0,0,0" Padding="12,0" Click="OnApplyTileGap"/>
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
            <!-- There is no Workspaces tab. Petre (2026-11-22): "managing workspaces from within settings is not needed
                 anymore". The bar adds, renames, deletes and reorders workspaces (its menus and its edit mode), and
                 workspace memory is opt-in per app on a window icon's menu ("Remember <app>'s workspace"), which is
                 how a wrong placement is undone now, so the roster list that sat on the tab had nothing left to do. -->
            <TabItem Header="Shortcuts">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Deskbar registers these two shortcuts with Windows, so while it runs no other app can use them. The defaults avoid chords other tools already use."/>
                    <StackPanel>
                        <TextBlock Text="Switch workspaces, Alt+Tab style" FontWeight="Bold"/>
                        <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,8"
                                   Text="Hold the modifiers and tap the key to walk workspaces, most recently used first; release to switch. Add Shift to walk backwards. The default, Win+Ctrl+Tab, sits beside Windows' own Win+Ctrl+arrows. Avoid chords other apps need: Ctrl+Tab would stop reaching browsers, editors and Explorer."/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="SwitcherShortcutBox" Width="220" TextChanged="OnSwitcherShortcutTyped"/>
                            <Button Content="Apply" Margin="8,0,0,0" Padding="12,2" Click="OnApplySwitcherShortcut"/>
                            <Button Content="Reset to default" Margin="8,0,0,0" Padding="12,2" Click="OnResetSwitcherShortcut"/>
                        </StackPanel>
                        <!-- Live validation, which is the reason Chord.Parse returns a Result
                             instead of throwing: the reason a chord is rejected is shown as it
                             is typed, before anything tries to register it. -->
                        <TextBlock x:Name="SwitcherShortcutStatus" TextWrapping="Wrap" Margin="0,6,0,0"/>

                        <!-- Quick find's chord (docs/superpowers/specs/2026-11-04-quick-find-design.md),
                             the same shape as the switcher's: typed, validated live, applied. The two
                             can never be set to one chord (WorkspaceManager.SetQuickFindShortcut). -->
                        <TextBlock Text="Quick find" FontWeight="Bold" Margin="0,20,0,0"/>
                        <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,8"
                                   Text="Opens a search box over every window, browser tab and VS Code tab on every workspace. Type a few letters of anything in its title, in any order; Enter takes you there. The default is Win+Alt+Space."/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="QuickFindShortcutBox" Width="220" TextChanged="OnQuickFindShortcutTyped"/>
                            <Button Content="Apply" Margin="8,0,0,0" Padding="12,2" Click="OnApplyQuickFindShortcut"/>
                            <Button Content="Reset to default" Margin="8,0,0,0" Padding="12,2" Click="OnResetQuickFindShortcut"/>
                        </StackPanel>
                        <TextBlock x:Name="QuickFindShortcutStatus" TextWrapping="Wrap" Margin="0,6,0,0"/>

                        <TextBlock TextWrapping="Wrap" Opacity="0.75" Margin="0,20,0,0"
                                   Text="These are the only keyboard shortcuts Deskbar registers. Everything else is on the floating bar: click a row label to switch to that workspace, click an icon to jump to a window, drag an icon to another row to move it."/>
                    </StackPanel>
                </DockPanel>
            </TabItem>
            <!-- #53. Petre's ruling on what counts: active means keyboard or mouse activity, and
                 pure wall-clock presence does not. The wording below says so plainly, because a
                 number labelled just "time" would be read as wall-clock and quietly disbelieved
                 the first time it disagreed with the clock on the wall. -->
            <TabItem Header="Time">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"
                               Text="Active time per workspace. Only typing or moving the mouse counts, so a workspace left on screen overnight adds nothing, and watching a video without touching anything counts as idle."/>
                    <TextBlock x:Name="TimeStatus" DockPanel.Dock="Bottom" Opacity="0.75" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <DataGrid x:Name="TimeGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <!-- Group first, so a group's workspaces read as belonging to it and sorting
                                 by this column brings them together. Empty for a workspace in no group. -->
                            <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="140"/>
                            <DataGridTextColumn Header="Workspace" Binding="{Binding Workspace}" Width="*"/>
                            <!-- SortMemberPath, and it is the whole point of these three columns having two
                                 properties each: the cell shows "1h 45m" and the sort compares a TimeSpan.
                                 Bound to the text alone, the grid sorted "1h 45m" above "47m". -->
                            <DataGridTextColumn Header="Today" Binding="{Binding Today}" SortMemberPath="TodayTime" Width="110"/>
                            <DataGridTextColumn Header="This week" Binding="{Binding ThisWeek}" SortMemberPath="ThisWeekTime" Width="110"/>
                            <DataGridTextColumn Header="Last 30 days" Binding="{Binding LastMonth}" SortMemberPath="LastMonthTime" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
            <!-- There is no Rules tab. Petre (2026-11-22): "those rules should be created by the bar itself, not humans".
                 Rename rules are made by the bar's "Rename by title pattern…" and unmade by its "Restore title"
                 (WorkspaceManager.RestoreTitle); where an app opens is "Remember <app>'s workspace" on its icon menu. -->

            <!-- Deskbar Pro (ManageWindow.Pro.cs fills it; what it says in each state is ProTab, in Core). Last, after
                 Rules, as in the mockup Petre approved on 2026-11-22. Every text that changes with the state is set
                 from code; only the fixed parts are written here. The look is the other tabs' stock look, with one
                 exception: the buy button is solid blue with white text, the one control in Manage that costs money.
                 It has its own small template because the stock button's hover turns its background pale blue, which
                 would leave white text unreadable. -->
            <TabItem x:Name="ProTabItem" Header="Deskbar Pro">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <Ellipse x:Name="ProStatusDot" Width="9" Height="9" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ProStatus" FontSize="13" Margin="8,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="ProPitch" TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TextBlock x:Name="ProStoreNote" TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                            <Button x:Name="ProBuy" Click="OnProBuy" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Face" Background="#FF0067C0" BorderBrush="#FF0067C0" BorderThickness="1" Padding="16,3">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Face" Property="Background" Value="#FF005A9E"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Face" Property="Background" Value="#FF004C87"/>
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Face" Property="BorderBrush" Value="#FF00263A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <TextBlock x:Name="ProBuyText" Foreground="White" FontWeight="SemiBold"/>
                            </Button>
                        </StackPanel>
                        <TextBlock Text="Priority support" FontWeight="Bold"/>
                        <TextBlock x:Name="ProSupport" TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ProReport" Content="Report a problem…" Padding="12,2" Click="OnProReport"/>
                        </StackPanel>
                        <TextBlock x:Name="ProCheckRow" TextWrapping="Wrap" Opacity="0.75" Margin="0,16,0,0">
                            <Run Text="Pro belongs to your Microsoft account. Bought it on another PC?"/>
                            <Hyperlink x:Name="ProCheckAgain" Click="OnProCheckAgain">Check again</Hyperlink>
                        </TextBlock>
                        <TextBlock x:Name="ProCheckNote" TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- The "Windows" tab is deliberately gone. Petre: "no need for that window tab",
                 "what's the point of it? we already have floating window manager doing just
                 that". The floating bar covers jumping to a window and dragging windows
                 between workspaces, which is what the tab was mostly used for.
                 What went with it, so the loss is on the record rather than discovered later:
                 ▶ Start (relaunch a workspace's apps), Add app… and the dimmed not-running
                 roster rows. The roster itself still drives placement memory, and the
                 Workspaces tab lists and removes its entries. There is no launching and no
                 restore prompt (CLAUDE.md, "No launching, no restore prompt"). -->
        </TabControl>
    </DockPanel>
</Window>
