<Window x:Class="Deskbar.App.NewWorkspaceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New workspace"
        Width="440" SizeToContent="Height" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Icon="pack://application:,,,/Deskbar;component/Assets/deskbar.ico">
    <!-- The New workspace dialog with its folder (task 6edcc65a, option A of the mockup): the name, then the folder
         Claude sessions for the workspace's tasks start in. The folder box follows the name as a subfolder of the one
         repos folder until it is edited; its list is the folders already there; empty is "no folder". The line under
         it says which of the three the box holds now, so a new folder is never made by surprise. -->
    <StackPanel Margin="12">
        <TextBlock Text="Name:" Margin="0,0,0,8"/>
        <TextBox x:Name="NameInput"/>
        <TextBlock Text="Folder for Claude sessions (empty for none):" Margin="0,12,0,8"/>
        <DockPanel>
            <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Browse…" Padding="10,2" Margin="6,0,0,0"
                    Click="OnBrowse"/>
            <ComboBox x:Name="FolderInput" IsEditable="True" IsTextSearchEnabled="False"/>
        </DockPanel>
        <TextBlock x:Name="FolderHint" TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.7" FontSize="11"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="OK" Padding="16,4" IsDefault="True" Click="OnOk"/>
            <Button Content="Cancel" Padding="12,4" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
