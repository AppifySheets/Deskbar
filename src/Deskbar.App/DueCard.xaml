<Window x:Class="Deskbar.App.DueCard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Deskbar.App"
        Title="Deskbar task due"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        Width="300" SizeToContent="Height"
        Cursor="Hand">
    <!-- THE DUE CARD (see DueCard.xaml.cs). Borderless and transparent like the bar, set in XAML because WPF throws
         when these are assigned imperatively in the wrong order. The Border has the bar's own background and
         corner radius. The three lines are filled in code. The background is the bar's flat surface
         (BarSurface.Solid): only the band behind the workspace rows is see-through. -->
    <Border CornerRadius="8" Background="{x:Static app:BarSurface.Solid}" Padding="12,10">
        <StackPanel>
            <TextBlock x:Name="TitleText" Foreground="#FFF2F2F2" FontSize="14" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Ellipse x:Name="Swatch" Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="WorkspaceText" Foreground="#FFB8B8BC" FontSize="12" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <TextBlock x:Name="DueText" Foreground="#FF8A8A90" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>
    </Border>
</Window>
