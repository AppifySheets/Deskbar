<Window x:Class="Deskbar.App.TasksWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tasks"
        WindowStyle="None" ResizeMode="NoResize" Background="#FF1E1F24"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False">
    <!-- THE TASKS PANEL (docs/superpowers/specs/2026-11-23-tasks-panel-design.md, "The panel window"; the board itself
         is docs/superpowers/specs/2026-11-22-tasks-board-design.md, "The window"): every task and its status, grouped,
         with filters by status and by workspace, and a comment thread under each line. Display only: TasksBoard decides
         what is shown and what a click does.

         A full-height panel docked just inside the bar, as a second shell app bar (TasksPanel places it and reserves its
         strip), so maximized windows, Snap and new windows keep clear of it. It replaced the floating window that had a
         title bar, a remembered place and a size of its own (plan 2026-11-23-tasks-panel, Task 6). So: no title bar, not
         resizable by Windows, not on the taskbar, not in Alt+Tab (WS_EX_TOOLWINDOW, TasksWindow's SourceInitialized),
         topmost like the bar. No Width, Height or MinWidth here on purpose: the panel sets the window's rectangle in
         physical pixels, and a size of WPF's own would be applied again on Show over the docked one. The width is the
         grip's (below), never under the panel's 360 DIP (TasksPanelLayout). The × at the end of the toolbar closes it,
         as `tasks-window hide` does. The list scrolls inside it, so opening a thread or a new task arriving never moves
         its edges.

         The rows, the chips and the toolbar's buttons are built in code-behind, like every list in this app, so each
         can carry its workspace's colour. The templates below are the only styling: the app runs WPF's Fluent theme,
         whose boxed buttons and fields would look like a dialog rather than part of the bar. -->
    <Window.Resources>
        <!-- One flat button for the chips and the small buttons: a rounded fill that lightens under the pointer. -->
        <ControlTemplate x:Key="FlatButton" TargetType="Button">
            <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="4"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Face" Property="Opacity" Value="0.8"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <!-- A task link in the Stats view (task 521d2b07, TasksWindow.Stats.cs): FlatButton with its content stretched
             across the line, so the status and the title start at the left edge instead of the middle. -->
        <ControlTemplate x:Key="LinkButton" TargetType="Button">
            <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="4"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Face" Property="Background" Value="#FF24262C"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <!-- A line, drawn as a tile (Petre's pick, option E of the task-separation mockup, 2026-11-25: "better task
             separation with lines or something"). The Button's Background is the tile's own fill, set per line in
             TasksWindow.Line (TileFill, or AskTint while the task waits on him), and the corners are rounded. The hover
             is a faint white wash laid UNDER the content rather than a fill swapped in, so it lightens whichever fill
             the tile has (plain or waiting) and the selection's translucent fill on top still reads through. The content
             is stretched across so the title has the width to trim against. -->
        <ControlTemplate x:Key="LineButton" TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="4">
                <Grid>
                    <Border x:Name="Hover" Background="#14FFFFFF" CornerRadius="4" Visibility="Hidden" IsHitTestVisible="False"/>
                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Hover" Property="Visibility" Value="Visible"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <!-- Quick find's bare text box: the system style draws its own box, underline and clear button inside ours. -->
        <ControlTemplate x:Key="BareTextBox" TargetType="TextBox">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                          HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto"/>
        </ControlTemplate>
        <!-- A comment's rendered markdown, read only, with nothing drawn around it. -->
        <ControlTemplate x:Key="BareRichTextBox" TargetType="RichTextBox">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"/>
        </ControlTemplate>
        <!-- The width grip: a hairline down the middle of a 6 DIP band, the whole band taking the press, and the line
             going blue under the pointer and while dragged. -->
        <ControlTemplate x:Key="GripTemplate" TargetType="Thumb">
            <Border Background="Transparent">
                <Rectangle x:Name="Line" Width="1" Fill="#FF33353C" HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Line" Property="Fill" Value="#FF4F8CFF"/>
                </Trigger>
                <Trigger Property="IsDragging" Value="True">
                    <Setter TargetName="Line" Property="Fill" Value="#FF4F8CFF"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>
    <!-- The grip on the inner edge, the one facing the windows (TasksWindow.SetInnerEdge moves it to the other side when
         the panel docks on the left), then the board. Docked beside the board, not over it, so it never covers the
         list's scroll bar. -->
    <DockPanel>
    <Thumb x:Name="Grip" DockPanel.Dock="Left" Width="6" Cursor="SizeWE" Template="{StaticResource GripTemplate}"
           ToolTip="Drag to change the panel's width"/>
    <Border Background="#FF1E1F24">
        <DockPanel>
            <!-- The toolbar, the approved mockup's three rows, top to bottom (tasks panel plan, Task 7):
                   1. the title line: "Tasks" on the left, ToolbarEnd (List / Matrix, "+ Add", ×) on the right, nothing else;
                   2. the search row, the full width of the panel;
                   3. the filter chips (Filters: the status chips with their counts, "Claude working", the workspace,
                      assignee and goal filters), wrapping onto more lines as the panel narrows.
                 The chips used to share the title line, where a narrow panel squeezed them against the end buttons.
                 Focusable so the window has somewhere to put the keyboard that is not a text box: it opens on
                 the board, not on a form (TasksWindow.Open). Its bottom hairline runs under all three rows. -->
            <Border x:Name="Toolbar" DockPanel.Dock="Top" BorderBrush="#FF33353C" BorderThickness="0,0,0,1" Padding="10,8"
                    Focusable="True" FocusVisualStyle="{x:Null}">
                <StackPanel>
                    <!-- 1. The title line. ToolbarEnd docks right first, so the title, the last child, takes the rest. -->
                    <DockPanel>
                        <StackPanel x:Name="ToolbarEnd" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ToolbarTitle" Text="Tasks" FontWeight="SemiBold" FontSize="13" Foreground="#FFE6E6E6"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"/>
                    </DockPanel>
                    <!-- 2. The search row (spec "The new filters"): under the title line, the full width of the panel.
                         Typing narrows the list and the Matrix at once; Ctrl+F anywhere in the panel puts the keyboard
                         here, Esc here empties it and gives the keyboard back to the board (TasksWindow, "the search
                         box"). Its edge goes blue while it has the keyboard, like the add box's. -->
                    <Border x:Name="SearchRow" Margin="0,6,0,0" CornerRadius="4"
                            Background="#FF15161A" BorderThickness="1" Padding="6,3">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="#FF33353C"/>
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="#FF4F8CFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <!-- The box takes the width; the second column holds the clear button (×), built in code-behind
                             (TasksWindow.BuildSearchClear) from the same flat button as the toolbar's ×, and shown only
                             while the box has text. Its column is Auto, so with the button collapsed the box keeps the
                             whole row. -->
                        <Grid x:Name="SearchField">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchBox" FontSize="12" Foreground="#FFE6E6E6" Background="Transparent"
                                     BorderThickness="0" CaretBrush="White" Padding="0" Template="{StaticResource BareTextBox}"
                                     AutomationProperties.Name="Search" VerticalAlignment="Center"/>
                            <TextBlock x:Name="SearchPlaceholder" Text="Search titles, status lines and questions" FontSize="12"
                                       Foreground="#FF8B8F99" IsHitTestVisible="False" Margin="2,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <!-- 3. The filter chips, built in code-behind (TasksWindow.DrawFilters), wrapping as needed. Each chip
                         has a 4 DIP bottom margin (ChipRowGap), so wrapped rows stand 4 DIP apart as in the approved
                         mockup; the panel's -4 bottom margin takes the last row's back, so the toolbar is no taller. -->
                    <WrapPanel x:Name="Filters" Margin="0,6,0,-4"/>
                </StackPanel>
            </Border>
            <!-- The add box, shown by "+ Add" and hidden again by Enter or Esc. Pictures pasted or dropped on it wait as
                 thumbnails in AddPictures, under the box, and become the new task's description (TasksWindow.Images.cs,
                 "the add box"). -->
            <Border x:Name="AddRow" DockPanel.Dock="Top" Visibility="Collapsed" Padding="10,6,10,6"
                    BorderBrush="#FF33353C" BorderThickness="0,0,0,1">
              <StackPanel>
                <DockPanel>
                    <StackPanel x:Name="AddEnd" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"/>
                    <Border CornerRadius="4" Background="#FF15161A" BorderBrush="#FF4F8CFF" BorderThickness="1" Padding="6,3">
                        <Grid>
                            <TextBox x:Name="AddBox" FontSize="12" Foreground="#FFE6E6E6" Background="Transparent"
                                     BorderThickness="0" CaretBrush="White" Padding="0" Template="{StaticResource BareTextBox}"/>
                            <TextBlock x:Name="AddPlaceholder" Text="A note: Enter adds it, Esc closes the box" FontSize="12"
                                       Foreground="#FF8B8F99" IsHitTestVisible="False" Margin="2,0,0,0"/>
                        </Grid>
                    </Border>
                </DockPanel>
                <WrapPanel x:Name="AddPictures" Margin="0,4,0,0" Visibility="Collapsed"/>
              </StackPanel>
            </Border>
            <!-- Why the last action failed, until the next one works (TasksWindow.ShowProblem). -->
            <TextBlock x:Name="ProblemText" DockPanel.Dock="Top" Foreground="#FFFFA726" FontSize="12" TextWrapping="Wrap"
                       Margin="12,6,12,0" Visibility="Collapsed"/>
            <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Foreground="#FF8B8F99" FontSize="12" Margin="12,10,12,0"
                       Visibility="Collapsed"/>
            <!-- The List (Scroller, the groups one under another) or the Matrix (MatrixGrid, Covey's 2 by 2, each cell
                 scrolling on its own; TasksWindow.Matrix.cs), whichever the toolbar's switch shows (Task 12). -->
            <Grid>
                <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False">
                    <StackPanel x:Name="Rows" Margin="0,0,0,8"/>
                </ScrollViewer>
                <Grid x:Name="MatrixGrid" Margin="6,4,8,8" Visibility="Collapsed" Background="Transparent"/>
                <!-- The Stats view (task 521d2b07, TasksWindow.Stats.cs): the four numbers, the open-tasks line, the added
                     and finished bars, and the picked day's tasks, each a link to its task. Shown by the toolbar's Stats
                     switch in place of the List or the Matrix. -->
                <ScrollViewer x:Name="StatsScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" Visibility="Collapsed">
                    <StackPanel x:Name="StatsPanel" Margin="12,8,12,12"/>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
    </DockPanel>
</Window>
