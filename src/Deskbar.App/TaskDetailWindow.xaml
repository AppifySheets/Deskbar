<Window x:Class="Deskbar.App.TaskDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Task" Width="980" Height="760" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterScreen" Background="#FF1E1F24" ShowActivated="False">
    <!-- A TASK IN A WINDOW OF ITS OWN (task dca4ebeb, Petre: "build a separate view that will open a task in, especially
         for longer tasks"; design docs/superpowers/specs/2026-11-25-task-window-design.md, mockup approved 2026-11-25).

         An ordinary window, unlike the tasks panel: a title bar, resizable and maximizable, on the taskbar and in Alt+Tab,
         so a long brief can be read and written at a width the 360 DIP panel never gives. Opened by "Open in window" on a
         line's menu (panel and bar), the thread's button and `deskbar.cmd task open <id>`; one window per task.

         From the top: the header (title, the chips, Edit and the "⋯" menu, the question or status line in full, the
         problem line), then the body. The body is the main column (the description, or the editor while editing, then the
         thread and the comment box) and, on a window at least 1100 DIP wide, a side column (sessions, subtasks, details);
         narrower, the side column's content moves under the thread (TaskDetailWindow.PlaceSide).

         Display only, like the panel: TasksBoard decides what is shown and every click goes back through the panel's own
         TasksWindowActions. The parts that change with the task are built in code-behind; the parts that hold what Petre
         is typing (the comment box, the editor) are here, built once, so a redraw never takes a half-written comment away.
         The colours are the panel's (TasksWindow), so a task looks the same in both. -->
    <Window.Resources>
        <!-- The panel's flat button: a rounded fill that lightens under the pointer. -->
        <ControlTemplate x:Key="FlatButton" TargetType="Button">
            <Border x:Name="Face" Background="{TemplateBinding Background}" CornerRadius="4"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
                <!-- The button's own HorizontalContentAlignment (centre by default), so a subtask's entry reads from the left. -->
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Face" Property="Opacity" Value="0.8"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <!-- A text box with nothing drawn around it: the Border around each box is the look. -->
        <ControlTemplate x:Key="BareTextBox" TargetType="TextBox">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Stretch"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"/>
        </ControlTemplate>
        <!-- Rendered markdown, read only, with nothing drawn around it. -->
        <ControlTemplate x:Key="BareRichTextBox" TargetType="RichTextBox">
            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"/>
        </ControlTemplate>
        <!-- A box's edge goes blue while it has the keyboard, as the panel's add and search boxes do. -->
        <Style x:Key="FieldEdge" TargetType="Border">
            <Setter Property="Background" Value="#FF15161A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="BorderBrush" Value="#FF33353C"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#FF4F8CFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- THE HEADER. -->
        <Border x:Name="Header" DockPanel.Dock="Top" BorderBrush="#FF33353C" BorderThickness="0,0,0,1" Padding="20,14,20,12"
                Focusable="True" FocusVisualStyle="{x:Null}">
            <StackPanel>
                <!-- The title (or, while editing, its box), with Edit and "⋯" on the right. -->
                <DockPanel>
                    <StackPanel x:Name="HeaderEnd" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,2,0,0"/>
                    <Grid>
                        <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" Foreground="#FFE6E6E6" TextWrapping="Wrap"/>
                        <Border x:Name="TitleField" Style="{StaticResource FieldEdge}" Padding="8,5" Visibility="Collapsed">
                            <TextBox x:Name="TitleBox" FontSize="18" FontWeight="SemiBold" Foreground="#FFE6E6E6" Background="Transparent"
                                     BorderThickness="0" CaretBrush="White" Padding="0" TextWrapping="Wrap" AcceptsReturn="True"
                                     Template="{StaticResource BareTextBox}" AutomationProperties.Name="Title"/>
                        </Border>
                    </Grid>
                </DockPanel>
                <!-- Status, workspace, assignee, the two flags, age; built in code-behind (TaskDetailWindow.DrawMeta). -->
                <WrapPanel x:Name="Meta" Margin="0,8,0,0"/>
                <!-- The question while the task waits on Petre, else its status line: in full, links clickable. -->
                <Border x:Name="DetailBox" Margin="0,8,0,0" CornerRadius="4" Padding="10,7" Visibility="Collapsed">
                    <TextBlock x:Name="DetailText" FontSize="12.5" TextWrapping="Wrap"/>
                </Border>
                <!-- Why the last action failed, until the next one works (TasksBoard.Report). -->
                <TextBlock x:Name="ProblemText" Foreground="#FFFFA726" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>
        <!-- THE BODY: the main column and the side column. -->
        <Grid x:Name="Body">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="SideColumn" Width="300"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="MainScroller" Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel Margin="20,16,20,20" MaxWidth="900" HorizontalAlignment="Stretch">
                    <!-- READING: the description, then the thread, then the comment box. -->
                    <StackPanel x:Name="ReadPanel">
                        <StackPanel x:Name="DescriptionHost"/>
                        <Border BorderBrush="#FF33353C" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,14,0,0">
                            <StackPanel>
                                <StackPanel x:Name="ThreadHost"/>
                                <Border Style="{StaticResource FieldEdge}" Padding="8,6" Margin="0,4,0,0">
                                    <Grid>
                                        <TextBox x:Name="CommentBox" FontSize="12.5" Foreground="#FFE6E6E6" Background="Transparent"
                                                 BorderThickness="0" CaretBrush="White" Padding="0" MinHeight="40" MaxHeight="260"
                                                 TextWrapping="Wrap" AcceptsReturn="True" Template="{StaticResource BareTextBox}"
                                                 AutomationProperties.Name="Comment"/>
                                        <TextBlock x:Name="CommentPlaceholder" FontSize="12.5" Foreground="#FF8B8F99" IsHitTestVisible="False"
                                                   Text="Write a comment. Ctrl+Enter posts; paste a picture to attach it"/>
                                    </Grid>
                                </Border>
                                <WrapPanel x:Name="CommentPictures" Margin="0,4,0,0" Visibility="Collapsed"/>
                                <StackPanel x:Name="CommentEnd" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- The side column's content on a narrow window (PlaceSide). -->
                        <StackPanel x:Name="SideNarrow" Margin="0,18,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                    <!-- EDITING: the description's markdown in a large box, a Preview of it, its pictures, Save and Cancel. -->
                    <StackPanel x:Name="EditPanel" Visibility="Collapsed">
                        <StackPanel x:Name="EditTabs" Orientation="Horizontal" Margin="0,0,0,6"/>
                        <Border x:Name="DescriptionField" Style="{StaticResource FieldEdge}" Padding="10,8">
                            <TextBox x:Name="DescriptionBox" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" Foreground="#FFE6E6E6"
                                     Background="Transparent" BorderThickness="0" CaretBrush="White" Padding="0" MinHeight="320"
                                     TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True" Template="{StaticResource BareTextBox}"
                                     AutomationProperties.Name="Description"/>
                        </Border>
                        <Border x:Name="PreviewField" BorderBrush="#FF33353C" BorderThickness="1" CornerRadius="4" Padding="10,8"
                                MinHeight="320" Visibility="Collapsed">
                            <RichTextBox x:Name="PreviewBox" IsReadOnly="True" IsDocumentEnabled="True" Background="Transparent"
                                         BorderThickness="0" Padding="0" Template="{StaticResource BareRichTextBox}"/>
                        </Border>
                        <WrapPanel x:Name="EditorPictures" Margin="0,6,0,0" Visibility="Collapsed"/>
                        <DockPanel Margin="0,10,0,0">
                            <StackPanel x:Name="EditEnd" DockPanel.Dock="Right" Orientation="Horizontal"/>
                            <TextBlock Foreground="#FF8B8F99" FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Text="Ctrl+S or Ctrl+Enter saves, Esc cancels. Paste a picture to add it to the description."/>
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
            <!-- The side column on a wide window. -->
            <Border x:Name="SideWideBorder" Grid.Column="1" Background="#FF18191D" BorderBrush="#FF33353C" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel x:Name="SideWide" Margin="16"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
