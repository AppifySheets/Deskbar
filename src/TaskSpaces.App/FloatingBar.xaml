<Window x:Class="TaskSpaces.App.FloatingBar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskSpaces"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
        PreviewMouseMove="OnPreviewMouseMove"
        PreviewMouseLeftButtonUp="OnPreviewMouseLeftButtonUp"
        PreviewMouseDown="OnPreviewMouseDown"
        PreviewMouseUp="OnPreviewMouseUp"
        SizeChanged="OnSizeChanged">
    <!-- Task 11 (spec: Floating icon bar): translucent, borderless, icon-only bar.
         AllowsTransparency requires WindowStyle=None; both set here in XAML (not
         code-behind) to dodge the "AllowsTransparency must be set before the window is
         shown, and WindowStyle must already be None" ordering exception WPF throws when
         these are set imperatively in the wrong order. -->
    <!-- Task 11 fix round 3 (reviewer, Petre: "can't drag it"): dragging is wired at
         the WINDOW level (Preview* handlers above, tunnelling from the root through
         every icon Button) rather than on this Border alone: the bar's surface is
         nearly all icon Buttons with only 6px of Padding as bare background, leaving
         almost nothing to grab. See FloatingBar.xaml.cs for the press/move/threshold
         logic; this Border no longer has its own MouseLeftButtonDown handler. -->
    <!-- Padding 6 -> 4 (Petre: "the padding and the spacing between icons could be reduced a
         little bit so that this whole thing is taking up less space"). Density is a separate
         axis from BarScale: the scale shrinks everything in proportion, while this makes the
         layout tighter at any scale. Not taken to zero, because the bar's bare background is
         what you grab to drag it, and at 0 the only draggable surface left would be the gaps
         between rows. -->
    <!-- Darker and more opaque with the accent rail style (Petre: "try b"): the rows are no longer tinted,
         so the bar's own background is what they sit on, and at 60% the desktop behind showed through
         enough to muddy the rails. -->
    <Border x:Name="Root" CornerRadius="8" Background="#E6141518" Padding="4">
        <!-- No "Hide floating bar" menu any more. Petre: "show floating bar doesn't make
             sense anymore, it's crucial for the app's design." Once the switcher panel and the
             Windows tab were gone this bar became the only surface that lists windows and
             jumps to them, so hiding it left no way to reach your own windows. Always on. -->
        <!-- A DockPanel rather than a StackPanel for one reason: the taskbar strip at the bottom. Docked to a
             screen edge the bar is the screen's full height, and Petre: "pin it to the bottom", so the strip
             sits at the foot of the screen where the taskbar was, and the clock stays put however many rows
             expand above it. Floating, the bar is only as tall as its content, so the same layout puts the
             strip straight under the last row. -->
        <DockPanel LastChildFill="True">
            <!-- The rest of the taskbar's own buttons: the tray chevron, quick settings and the bell from the
                 left, the clock and the show desktop sliver at the right, where Windows puts them. Filled once
                 in BuildShellStrip (FloatingBar.Shell.cs). A hairline above it, because unlike the rows it is
                 not a workspace and should not read as one more. Declared first because a DockPanel docks its
                 children in order, and the strip has to claim the bottom before the rows take the rest. -->
            <Border x:Name="ShellFooter" DockPanel.Dock="Bottom" BorderBrush="#14FFFFFF" BorderThickness="0,1,0,0"
                    Margin="0,3,0,0" Padding="0,3,0,0">
                <DockPanel x:Name="ShellStrip" LastChildFill="False"/>
            </Border>

        <StackPanel>
            <!-- The bar's two commands. Petre: "move those buttons down next to the pin icon;
                 remove the pin icon and have those buttons at the right."
                 So they live in the PINNED ROW's caption cell now, and the pin glyph that used to
                 sit there is gone: the row was already reserved, already always rendered, and its
                 caption cell was carrying one decorative glyph. RebuildCore moves this strip into
                 that cell on every rebuild, which is why it is declared here rather than built
                 there: the buttons keep their identity, their handlers and their x:Names across
                 every rebuild, and only their parent changes.
                 Declared as a child of this panel so it has somewhere to be before the first
                 rebuild. Nothing flashes: ShowBar rebuilds before it shows. -->
            <!-- The header line as a whole: Windows' Start and search on the LEFT (Petre's pick, "c", from the
                 taskbar strip mockups; see FloatingBar.Shell.cs), the bar's own two commands on the right. One
                 Grid moved into the pinned row's caption cell as a unit, for the reason given above. -->
            <Grid x:Name="BarHeader">
            <StackPanel x:Name="ShellStart" Orientation="Horizontal"
                        HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <StackPanel x:Name="BarCommands" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BackButton" Content="↩" Width="18" FontSize="12"
                        Foreground="White" Background="Transparent" BorderThickness="0"
                        Padding="0" VerticalAlignment="Center" Click="OnBackClick"/>
                <!-- Petre, with the two buttons blown up: "these two aren't really aligned to one
                     another, do align them." Measured rather than nudged by eye, at this button's own
                     12pt in a 15.96 DIP line, as the ink each glyph actually paints:
                       '↩'  ink 4.04 to 12.07,  centre 8.05
                       '▁'  ink 14.00 to 15.53, centre 14.77   <- 6.7 DIP below the arrow
                       '—'  ink 9.23 to 9.99,   centre 9.61
                     A lower one eighth block sits ON the baseline floor by design, which is exactly
                     what made it look dropped next to an arrow that sits mid line. The em dash is the
                     nearest plain glyph to the arrow's centre, and the 1.56 DIP that remains is taken
                     out by the transform below, so the two inks share a centre line.
                     Plain Unicode rather than Segoe MDL2's ChromeMinimize: this file's MenuGlyph
                     comment already rejected MDL2 here, because a private use codepoint that turns
                     out wrong renders as a hollow box rather than as anything recognisable.
                     BarMinimizeTests measures both glyphs and fails if they drift apart again. -->
                <Button x:Name="MinimizeButton" Content="—" Width="18" FontSize="12"
                        Foreground="White" Background="Transparent" BorderThickness="0"
                        Padding="0" VerticalAlignment="Center" Click="OnMinimizeClick"
                        ToolTip="Minimize the bar to a taskbar button">
                    <Button.RenderTransform>
                        <TranslateTransform Y="-1.56"/>
                    </Button.RenderTransform>
                </Button>
            </StackPanel>
            </Grid>

            <!-- One horizontal row per group (Pinned first, then every workspace, then
                 unbound desktops with windows), populated in code-behind (Rebuild). -->
            <StackPanel x:Name="Rows"/>

            <!-- The current workspace's windows with their titles, below every row (Petre: "same as it
                 is now but at the bottom", "so workspaces don't change sizes every time i click them").
                 A panel of its own rather than one more child of Rows, because it is not a workspace row:
                 everything that walks Rows (ring painting, hover, row lookups) means the rows, and a
                 second element carrying the current workspace's name would be found twice. Filled in
                 RebuildCore. -->
            <StackPanel x:Name="CurrentList"/>

        </StackPanel>
        </DockPanel>
    </Border>
</Window>
